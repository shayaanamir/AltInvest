# Production image: builds the static assets and serves them with an unprivileged nginx on port 8080.
# nginx also proxies /api/ to the backend (see nginx.conf), so the bundle calls its own origin and needs no
# per-environment URL, and the browser needs no CORS.
#
# Normally built by docker-compose.prod.yml. By hand, from frontend/:
#   docker build -f Dockerfile.prod -t altinvest-frontend:prod .
#
# Vite bakes VITE_* vars in at BUILD time. VITE_API_BASE_URL defaults to /api (the nginx proxy); pass
# --build-arg VITE_API_BASE_URL=https://api.example.com only to call a backend on another origin directly
# (that backend must then list this site in FRONTEND_BASE_URL / CORS_EXTRA_ORIGINS, and the CSP in
# nginx-security-headers.conf must allow it in connect-src).

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
