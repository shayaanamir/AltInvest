# ── Shared secrets ────────────────────────────────────────────────────────────
CMC_API_KEY='add_your_cmc_api_key'

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── MongoDB Atlas Connection ───────────────────────────────────────────────────────────
MONGO_URI=
MONGO_DB_NAME=
# ── Auth ──────────────────────────────────────────────────────────────────────
# Signs login tokens. Required for any shared or deployed instance; without it the backend uses a
# public development secret and logs a warning. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Where the frontend lives, for links in password-reset and verification emails.
FRONTEND_BASE_URL=http://localhost:5173

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty in development: emails aren't sent and their links are printed to the
# backend log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER.
SMTP_FROM=
SMTP_STARTTLS=true
