# Crypto market data (CoinGecko, Binance) and the news feeds need no API key. CoinMarketCap is no longer used.

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── MongoDB Atlas Connection ───────────────────────────────────────────────────────────
MONGO_URI=
MONGO_DB_NAME=
# Optional: the backend container's database (docker-compose). Empty = the local mongodb container.
BACKEND_MONGO_URI=
BACKEND_MONGO_DB_NAME=
# ── Auth ──────────────────────────────────────────────────────────────────────
# Signs login tokens. Required for any shared or deployed instance; without it the backend uses a
# public development secret and logs a warning. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Where the frontend lives, for links in password-reset and verification emails.
FRONTEND_BASE_URL=http://localhost:5173
# Set to true only behind a reverse proxy you control that sets X-Forwarded-For; sign-in attempt
# limits then use the real client IP instead of the proxy's.
TRUST_PROXY_HEADERS=false

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty in development: emails aren't sent and their links are printed to the
# backend log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER.
SMTP_FROM=
SMTP_STARTTLS=true

# ── NFT data sources (Phase 10) ───────────────────────────────────────────────
OPENSEA_API_KEY=
ALCHEMY_API_KEY=

# ── NFT news sentiment (sentiment_engine/nft_sentiment) ───────────────────────
# Groq API key (console.groq.com). Without it NFT news is scored with VADER + FinBERT instead.
GROQ_API_KEY=
# Optional; any Groq model with strict structured outputs (e.g. openai/gpt-oss-20b, cheaper and faster).
NFT_SENTIMENT_MODEL=openai/gpt-oss-120b
