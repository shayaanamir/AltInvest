# Crypto market data (CoinGecko, Binance) and the news feeds need no API key. CoinMarketCap is no longer used.

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── MongoDB Atlas Connection ───────────────────────────────────────────────────────────
MONGO_URI=
MONGO_DB_NAME=
# Optional: the backend container's database (docker-compose). Empty = the local mongodb container.
BACKEND_MONGO_URI=
BACKEND_MONGO_DB_NAME=
# ── Environment ───────────────────────────────────────────────────────────────
# dev on a developer machine. Anything else (or unset) is treated as production: the backend
# refuses to start without a real JWT_SECRET, the demo user is never seeded, and email links are
# never written to the log.
APP_ENV=dev

# ── Auth ──────────────────────────────────────────────────────────────────────
# Signs login tokens. At least 32 bytes; required unless APP_ENV=dev (then a public development
# secret is used and a warning logged). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Where the frontend lives: links in password-reset and verification emails, and the only origin
# the API accepts cross-origin requests from (CORS).
FRONTEND_BASE_URL=http://localhost:5173
# Optional: more origins allowed to call the API, comma-separated (e.g. http://127.0.0.1:5173).
CORS_EXTRA_ORIGINS=
# Verified accounts allowed to force sentiment pipeline refreshes (comma-separated emails). Empty:
# nobody; the scheduler still refreshes every 15 minutes.
ADMIN_EMAILS=
# Set to true only behind a reverse proxy you control that sets X-Forwarded-For; sign-in attempt
# limits then use the real client IP instead of the proxy's.
TRUST_PROXY_HEADERS=false

# ── Sign in with Google ───────────────────────────────────────────────────────
# Leave empty to keep the Google buttons disabled. To set up: Google Cloud console -> APIs & Services ->
# Credentials -> Create OAuth client ID -> "Web application". Under "Authorized JavaScript origins" add
# every origin the frontend is served from (e.g. http://localhost:5173). No redirect URI is needed (the
# sign-in popup hands the code straight back to the page). The client ID reaches the browser through
# GET /auth/providers; the secret stays on the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty in development: emails aren't sent and their links are printed to the
# backend log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER.
SMTP_FROM=
SMTP_STARTTLS=true

# ── NFT data sources (Phase 10) ───────────────────────────────────────────────
OPENSEA_API_KEY=
ALCHEMY_API_KEY=

# ── NFT news sentiment (sentiment_engine/nft_sentiment) ───────────────────────
# Groq API key (console.groq.com). Without it NFT news is scored with VADER + FinBERT instead.
GROQ_API_KEY=
# Optional; any Groq model with strict structured outputs (e.g. openai/gpt-oss-20b, cheaper and faster).
NFT_SENTIMENT_MODEL=openai/gpt-oss-120b
