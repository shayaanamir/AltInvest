# Production settings for docker-compose.prod.yml (audit G-11). Copy to .env.prod (git-ignored), fill in, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# With --env-file, compose reads only this file, never the development .env.
#
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (URL-safe matters for MONGO_APP_PASSWORD: it goes into a mongodb:// URI unescaped.)

# ── Required ──────────────────────────────────────────────────────────────────
# The public address users open (scheme + host, no trailing slash). Used for email links and CORS.
FRONTEND_BASE_URL=
# Signs login tokens; at least 32 bytes.
JWT_SECRET=
# MongoDB: the administrator, and the app's own user (readWrite on MONGO_DB_NAME only). Both are created when
# the mongo_data volume is first created; changing them later needs mongosh (deploy/mongo-init/01-app-user.js).
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=altinvest
MONGO_APP_PASSWORD=
MONGO_DB_NAME=aaip_db

# ── Optional ──────────────────────────────────────────────────────────────────
# Host port nginx is published on. Put a TLS proxy in front of it.
HTTP_PORT=80
# Use an external database (e.g. Atlas) instead of the bundled one. The bundled mongodb still starts.
PROD_MONGO_URI=
# uvicorn worker processes for the backend (each loads FinBERT, about 1 GB of memory).
WEB_CONCURRENCY=1
# More origins allowed to call the API cross-origin (comma-separated). Not needed for the site itself.
CORS_EXTRA_ORIGINS=
# Verified accounts allowed to force sentiment refreshes (comma-separated emails).
ADMIN_EMAILS=

# Email. Without SMTP, new users can't verify their address outside development, so set this before launch.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Sign in with Google. Add FRONTEND_BASE_URL to the OAuth client's "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NFT data and NFT news sentiment.
OPENSEA_API_KEY=
ALCHEMY_API_KEY=
GROQ_API_KEY=
NFT_SENTIMENT_MODEL=openai/gpt-oss-120b
