# ML training and evaluation image (Phase 9, D45). Build from the REPO ROOT:
#   docker build -f ml/Dockerfile.train -t altinvest-ml-train .
#
# Serving requirements plus ml/requirements-train.txt (prophet, torch CPU, lightgbm, arch). The serving image
# (ml/Dockerfile) never installs these. Not part of docker-compose.yml.
#
# Evaluation runs on the snapshot in the repo (D40), which .dockerignore keeps out of the image, so mount the
# repo over /app and leave ML_RAW_DIR / ML_VALIDATION_DIR unset:
#   docker run --rm -v "${PWD}:/app" altinvest-ml-train python -m ml.evaluation.<module> --asset btc
#   docker run --rm -v "${PWD}:/app" altinvest-ml-train python -m pytest ml -q

FROM python:3.12-slim

# git: test_gitinfo.py and the git commit recorded in reports. libgomp1: LightGBM's OpenMP runtime.
RUN apt-get update && apt-get install -y --no-install-recommends git libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# The mounted repo is owned by another uid; let git read it.
RUN git config --system --add safe.directory /app

WORKDIR /app

COPY ml/requirements.txt ml/requirements-train.txt ml/
RUN pip install --no-cache-dir --timeout 1000 --retries 10 -r ml/requirements.txt -r ml/requirements-train.txt

COPY ml/ ml/

ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "pytest", "ml", "-q"]
