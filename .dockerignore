**/.venv
**/venv
**/env
**/ENV
**/*.egg-info

# Node
**/node_modules
frontend/dist
frontend/build

# ML v2: raw CSVs and model artifacts are never baked into the image. The ml
# service fetches and validates its own serving data into the ml-data volume
# (ml/data/refresh.py, D40); ml/data/raw is the evaluation snapshot (host only).
ml/data/raw
ml/artifacts

# Git / IDE / OS
.git
.gitignore
.vscode
.idea
.DS_Store

# Env files (pass secrets via docker-compose environment / --env-file instead)
.env
**/.env
**/.env.*

# Logs
*.log
